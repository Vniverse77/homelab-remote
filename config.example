# homelab-remote configuration
# Copy to ~/.config/homelab-remote/config and fill in your values:
#   mkdir -p ~/.config/homelab-remote
#   cp config.example ~/.config/homelab-remote/config
# This file is sourced by bash, so use VAR="value" syntax.

# -- Home server (the always-on / GPU machine) -------------------------
SERVER_IP=""                    # Tailscale IPv4 of the server, e.g. 100.64.0.10
SERVER_USER=""                  # login user on the server
SERVER_MAC=""                   # MAC of the server's wired NIC (Wake-on-LAN)
LAN_BROADCAST="192.168.1.255"   # broadcast address of your home LAN

# -- SSH keys used by this laptop ---------------------------------------
CONTROL_KEY="$HOME/.ssh/homelab_control"   # restricted key: power control only
DEV_KEY="$HOME/.ssh/homelab_dev"           # full key for dev sessions (use a passphrase)

# -- pc -------------------------------------------------------------------
BOOT_TIMEOUT=150                # seconds to wait for the server to boot
DOWN_TIMEOUT=90                 # seconds to wait for the server to shut down
COUNTDOWN=10                    # countdown before off / restart
OLLAMA_CHECK="yes"              # warn before shutdown if Ollama has models loaded

# -- dev ------------------------------------------------------------------
PROJECTS_DIR=""                 # project folder on the server, e.g. /home/you/Projects

# -- camera ---------------------------------------------------------------
CAMERA_DEVICE="/dev/video0"
CAMERA_SIZE="1280x720"
CAMERA_FPS=15
CAMERA_INPUT_FORMAT="mjpeg"     # check with: v4l2-ctl --list-formats-ext
CAMERA_AUDIO="yes"              # "yes" to include the default microphone
CAMERA_PORT=8554
CAMERA_DEFAULT_MINUTES=30
CAMERA_MAX_MINUTES=720
